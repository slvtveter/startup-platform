{
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		# Только свои ресурсы (AGENTS.md, правило 7): внешние скрипты, шрифты и трекеры браузер не загрузит.
		# 'unsafe-inline' для скриптов нужен инлайн-данным гидрации Next; eval запрещён.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' wss://{$SITE_DOMAIN}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	# Загруженные файлы (KAN-34). Имя файла меняется при каждой загрузке, поэтому кеш вечный.
	handle /media/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options "nosniff"
		file_server
	}
	handle /api/* {
		# Самый большой запрос — аватар до 5 МБ. Гигабайтное тело Caddy отклонит, не передав в api.
		request_body {
			max_size 6MB
		}
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:3000
	}
}
