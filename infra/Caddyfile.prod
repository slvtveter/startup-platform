{
	email {$ACME_EMAIL}
	# Без HTTP/3 (QUIC по UDP): в РФ UDP 443 режут ТСПУ и многие VPN-клиенты, и наполовину
	# рабочий QUIC даёт «сайт открывается со второй попытки». HTTP/2 по TCP проходит везде,
	# шифрование то же (TLS 1.3). Порт 443/udp закрыт и в compose, и в ufw.
	servers {
		protocols h1 h2
	}
}

{$SITE_DOMAIN} {
	encode zstd gzip
	# Журнал запросов: время, путь, статус, протокол, длительность, IP и User-Agent.
	# Заголовки (там cookie) не пишем. Хранится в логах контейнера: 5 × 10 МБ, старое удаляется.
	log {
		output stderr
		format filter {
			request>headers delete
			request>tls delete
			resp_headers delete
		}
	}
	log_append ua {http.request.header.User-Agent}
	# Статика Next с хешем в имени: её много, и для диагностики она не нужна.
	log_skip /_next/static/*
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Только свои ресурсы (AGENTS.md, правило 7) плюс Яндекс Метрика (KAN-132): она грузится
		# лишь после согласия на cookie. Адреса — из справки Метрики про CSP.
		# 'unsafe-inline' для скриптов нужен инлайн-данным гидрации Next; eval запрещён.
		# frame-ancestors пускает в iframe только плеер Вебвизора, поэтому X-Frame-Options DENY убран:
		# он запретил бы и его, а остальным сайтам вставлять нас по-прежнему нельзя.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://mc.yandex.ru https://mc.yandex.com https://yastatic.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://mc.yandex.ru https://mc.yandex.com; font-src 'self'; connect-src 'self' wss://{$SITE_DOMAIN} https://mc.yandex.ru https://mc.yandex.com wss://mc.yandex.ru wss://mc.yandex.com; frame-src blob: https://mc.yandex.ru https://mc.yandex.com; child-src blob: https://mc.yandex.ru https://mc.yandex.com; frame-ancestors https://metrika.yandex.ru https://metrika.yandex.by https://metrika.yandex.kz https://metrica.yandex.com https://metrica.yandex.com.tr https://webvisor.com https://*.webvisor.com; base-uri 'self'; form-action 'self'; object-src 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	# Загруженные файлы (KAN-34). Имя файла меняется при каждой загрузке, поэтому кеш вечный.
	# Резюме — личные данные: отдаёт только api вошедшим (/api/people/{slug}/resume).
	handle /media/resumes/* {
		respond 404
	}
	# Скриншоты из «Сообщить о проблеме» — только для админки (/api/admin/feedback/…/screenshot).
	handle /media/private/* {
		respond 404
	}
	handle /media/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options "nosniff"
		file_server
	}
	handle /api/* {
		# Самый большой запрос — аватар до 5 МБ. Гигабайтное тело Caddy отклонит, не передав в api.
		request_body {
			max_size 6MB
		}
		reverse_proxy api:8000 {
			# Во время деплоя контейнер перезапускается ~10–25 с. Вместо мгновенной 502 Caddy ждёт
			# его до 30 с и доставляет запрос. Повтор только при неудачном подключении: до приложения
			# запрос ещё не дошёл, двойной отправки формы не будет.
			lb_try_duration 30s
			lb_try_interval 250ms
		}
	}
	handle {
		reverse_proxy web:3000 {
			# Во время деплоя контейнер перезапускается ~10–25 с. Вместо мгновенной 502 Caddy ждёт
			# его до 30 с и доставляет запрос. Повтор только при неудачном подключении: до приложения
			# запрос ещё не дошёл, двойной отправки формы не будет.
			lb_try_duration 30s
			lb_try_interval 250ms
		}
	}
}

# www ведёт на основной домен: одна каноническая версия для SEO и cookie.
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
