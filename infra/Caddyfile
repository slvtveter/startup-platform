# Локальная разработка: один origin http://localhost:8080
# /api/* -> FastAPI, всё остальное -> Next.js
:8080 {
	# Загруженные файлы (KAN-34). Имя файла меняется при каждой загрузке, поэтому кеш вечный.
	handle /media/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options "nosniff"
		file_server
	}
	handle /api/* {
		# Самый большой запрос — аватар до 5 МБ. Гигабайтное тело Caddy отклонит, не передав в api.
		request_body {
			max_size 6MB
		}
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:3000
	}
}
