# Шаблон для сервера: скопировать в infra/.env.prod (НЕ коммитить).
STACK=prod
SITE_DOMAIN=envola.ru
ACME_EMAIL=admin@envola.ru
IMAGE_TAG=main

POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=app

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Envola <noreply@envola.ru>

# Подпись ссылок отписки в письмах (openssl rand -hex 32). Без него api не стартует.
SECRET_KEY=

# Соль для хеша посетителя в аналитике (openssl rand -hex 32). IP не хранится.
EVENTS_SALT=

BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14

# Для staging: CADDYFILE=Caddyfile.staging, STACK=staging и логин/хеш пароля.
# CADDYFILE=Caddyfile.staging
# STAGING_USER=team
# STAGING_PASSWORD_HASH=

# Подтверждение прав в Яндекс Вебмастере и Google Search Console: только код из мета-тега (content="…").
# Пусто — тега нет. После правки: docker compose -f compose.prod.yml --env-file .env.prod up -d web
YANDEX_VERIFICATION=
GOOGLE_SITE_VERIFICATION=
