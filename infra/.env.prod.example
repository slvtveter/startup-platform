# Шаблон для сервера: скопировать в infra/.env.prod (НЕ коммитить).
STACK=prod
SITE_DOMAIN=example.com
ACME_EMAIL=admin@example.com
IMAGE_TAG=main

POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=app

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Startup Platform <noreply@example.com>

# Соль для хеша посетителя в аналитике (openssl rand -hex 32). IP не хранится.
EVENTS_SALT=

BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14

# Для staging: CADDYFILE=Caddyfile.staging, STACK=staging и логин/хеш пароля.
# CADDYFILE=Caddyfile.staging
# STAGING_USER=team
# STAGING_PASSWORD_HASH=
